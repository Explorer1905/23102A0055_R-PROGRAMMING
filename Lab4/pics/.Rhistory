table(Predicted = test_pred_class, Actual = testy)
# -------------------------
# 10. Compile the model
# -------------------------
model %>%
compile(loss = 'binary_crossentropy',
optimizer = optimizer_rmsprop(),
metrics = c('accuracy'))
